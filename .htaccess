<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Route any requests starting with /api to the Laravel backend
    RewriteCond %{REQUEST_URI} ^/api [NC]
    RewriteRule ^(.*)$ backend/public/$1 [L]

    # Route everything else to the compiled React frontend
    RewriteCond %{REQUEST_URI} !^/backend/public/
    RewriteRule ^(.*)$ frontend/dist/$1 [L]
</IfModule>
