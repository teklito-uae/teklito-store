<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. API requests → Laravel backend
    RewriteCond %{REQUEST_URI} ^/api [NC]
    RewriteRule ^(.*)$ backend/public/$1 [L]

    # 2. Backend public static files (sitemap.xml, robots.txt, storage/*, etc.)
    #    If the file physically exists in backend/public/, serve it directly
    RewriteCond %{DOCUMENT_ROOT}/backend/public/$1 -f
    RewriteRule ^(.*)$ backend/public/$1 [L]

    # 3. Frontend static assets (JS, CSS, images in dist/)
    RewriteCond %{DOCUMENT_ROOT}/frontend/dist/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/frontend/dist/$1 -d
    RewriteRule ^(.*)$ frontend/dist/$1 [L]

    # 4. Everything else → React SPA fallback (client-side routing)
    RewriteCond %{REQUEST_URI} !^/api [NC]
    RewriteCond %{REQUEST_URI} !^/backend/ [NC]
    RewriteRule ^(.*)$ frontend/dist/index.html [L]
</IfModule>
