<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # If the request starts with /api, pass it strictly to the Laravel index
    RewriteCond %{REQUEST_URI} ^/api [NC]
    RewriteRule ^(.*)$ backend/public/$1 [L]

    # If requesting an asset or static file in the frontend (e.g. /assets/js)
    RewriteCond %{DOCUMENT_ROOT}/frontend/dist/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/frontend/dist/$1 -d
    RewriteRule ^(.*)$ frontend/dist/$1 [L]

    # For any other web route (React Single Page App fallback), serve index.html
    # This ensures refreshing /cart or /products doesn't crash Apache
    RewriteCond %{REQUEST_URI} !^/api [NC]
    RewriteCond %{REQUEST_URI} !^/backend/ [NC]
    RewriteRule ^(.*)$ frontend/dist/index.html [L]
</IfModule>
